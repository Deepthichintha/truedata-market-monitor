# Application
APP_NAME=TrueData Market Monitor
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# TrueData WebSocket credentials
TRUEDATA_USERNAME=your_truedata_username
TRUEDATA_PASSWORD=your_truedata_password

# PostgreSQL
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/truedata_market_monitor

# SmartTheta
SMARTTHETA_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------
# Kite Connect provider evaluation (isolated from TrueData)
# ---------------------------------------------------------
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
# Optional: if set, the collector can use today's token directly.
# KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://127.0.0.1:8000/api/kite-test/callback
KITE_FRONTEND_URL=http://127.0.0.1:5173/?provider=kite&auth=success
KITE_INSTRUMENTS_FILE=data/kite_instruments.csv
